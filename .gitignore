## Umbraco runtime
# The seeded SQLite DBs and uploaded media files ARE committed so the demo runs
# out of the box. Logs and TEMP are runtime-only and stay ignored.
src/TheRabbitHole.Web/umbraco/Data/*.sqlite.db-*
src/TheRabbitHole.Web/umbraco/Data/TEMP/
src/TheRabbitHole.Web/umbraco/Logs/
src/TheRabbitHole.Web/umbraco/mediafilesystem/

## Secrets / machine-specific configuration
# appsettings.{Environment.MachineName}.json is loaded by Program.cs — store provider keys here
src/TheRabbitHole.Web/appsettings.*.json
!src/TheRabbitHole.Web/appsettings.json
!src/TheRabbitHole.Web/appsettings.Development.json
!src/TheRabbitHole.Web/appsettings-schema.json
!src/TheRabbitHole.Web/appsettings-schema.Umbraco.Cms.json

