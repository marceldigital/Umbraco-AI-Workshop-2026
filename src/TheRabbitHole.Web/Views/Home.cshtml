@using TheRabbitHole.Core.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<TheRabbitHole.Core.Models.Home>
@{
  Layout = "_Layout.cshtml";
  
  var episodesContainer = Model.Children<PodcastEpisodes>().FirstOrDefault();
  var featuredEpisodes = episodesContainer?.Children<PodcastEpisode>()
    .OrderByDescending(x => x.PublishDate).Take(Model.FeaturedEpisodes) ?? [];

  @* 
    Model properties (map to your Umbraco home content type):
      Model.PodcastName    – site/show name
      Model.Description    – hero blurb
      Model.ArtworkUrl     – podcast artwork (Umbraco media picker)
      Model.AppleUrl       – Apple Podcasts link
      Model.SpotifyUrl     – Spotify link
      Model.TrailerTitle   – trailer episode title
      Model.TrailerLength  – e.g. "2:48"
      Model.TrailerAudio   – trailer MP3 URL
      Model.RecentEpisodes – IEnumerable<EpisodeViewModel> (last 5)
  *@
}

<div class="page">
  
  <section class="hero">
    <div>
      <h1>@Model.IntroHeading</h1>
      @Model.IntroText
      <div class="btn-group">
        <a href="#" class="btn btn-primary" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          Apple Podcasts
        </a>
        <a href="/episodes" class="btn">Browse Episodes</a>
      </div>
    </div>

    <img class="hero-img"
         src="@(Model.IntroImage?.Url() ?? "/main-image.png")"
         alt="@Model.SiteName artwork" />
  </section>

  <section>
    <p class="section-title">Recent Episodes</p>
    <div class="episode-list">
      @foreach (var ep in featuredEpisodes)
      {
        @await Html.PartialAsync("_EpisodeCard", ep)
      }
    </div>
    <div style="margin-top:20px">
      <a href="/episodes" class="btn">View all episodes →</a>
    </div>
  </section>

</div>