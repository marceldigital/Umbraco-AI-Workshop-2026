@*
  Player bar — static decorative waveform with play icon.
*@

<div class="player-bar" x-data="playerApp()" x-init="init()">

  <button class="play-btn" aria-label="Play">
    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
  </button>

  <div class="waveform-wrap">
    <template x-for="(bar, i) in waveData" :key="i">
      <div :style="{
        height: Math.max(2, bar * 32) + 'px',
        background: i / waveData.length < 0.38 ? 'var(--accent)' : (darkMode ? '#2e2e2e' : '#d0d0d0')
      }"></div>
    </template>
  </div>

</div>

<script defer="defer">
  function playerApp() {
    return {
      waveData: [],

      get darkMode() {
        return document.documentElement.getAttribute('data-theme') === 'dark'
            || document.body.getAttribute('data-theme') === 'dark';
      },

      init() {
        this.waveData = this.buildWaveform(120);
      },

      buildWaveform(n) {
        return Array.from({ length: n }, (_, i) => {
          const t = i / n;
          return Math.min(1, Math.max(0.08,
            0.30 * Math.abs(Math.sin(t * Math.PI * 6.3 + 1.2)) +
            0.25 * Math.abs(Math.sin(t * Math.PI * 17  + 0.4)) +
            0.20 * Math.abs(Math.sin(t * Math.PI * 3.1)) +
            0.12 * Math.random()
          ));
        });
      }
    };
  }
</script>
